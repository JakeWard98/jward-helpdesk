# =============================================================================
# jward-helpdesk - environment template
# =============================================================================
# Copy to .env (never commit .env) or paste these into the Portainer stack's
# "Environment variables" pane. Generate every secret yourself:
#
#   openssl rand -hex 32
#
# =============================================================================

# ---------- Core ----------
# Public origin the browser uses. Must be https:// behind the Cloudflare tunnel.
PUBLIC_BASE_URL=https://helpdesk.example.com
# Comma-separated origins allowed to call the API (usually just PUBLIC_BASE_URL).
CORS_ORIGINS=https://helpdesk.example.com
# 64 hex chars. Signs sessions, CSRF tokens and mail reply tokens; encrypts TOTP
# secrets at rest. Rotating it logs everyone out and breaks stored TOTP secrets.
APP_SECRET=CHANGE_ME_openssl_rand_hex_32
# dev | prod. prod refuses to boot on insecure defaults.
APP_ENV=prod
LOG_LEVEL=INFO

# ---------- Database ----------
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=helpdesk
# Hostname "db" is the compose service name.
DATABASE_URL=postgresql+psycopg://helpdesk:CHANGE_ME_strong_db_password@db:5432/helpdesk

# ---------- First admin (seeded once, on an empty database) ----------
BOOTSTRAP_ADMIN_EMAIL=you@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_long_passphrase
# Admins must enrol MFA on first login when true.
REQUIRE_MFA_FOR_AGENTS=true

# ---------- Sessions ----------
SESSION_IDLE_TIMEOUT_MINUTES=120
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
# Leave true in production; only disable for plain-HTTP local development.
SESSION_COOKIE_SECURE=true

# ---------- Outbound email (SMTP) ----------
# Proton Mail SMTP submission (Proton Business plan, custom domain):
#   SMTP_HOST=smtp.protonmail.ch
#   SMTP_PORT=587
#   SMTP_SECURITY=starttls
#   SMTP_USERNAME=helpdesk@yourdomain.com     (the address the token is for)
#   SMTP_PASSWORD=<SMTP submission token>     (not your Proton password)
# Proton Mail Bridge instead:
#   SMTP_HOST=<bridge host>  SMTP_PORT=1025  SMTP_SECURITY=starttls
#   plus SMTP_CA_CERT or SMTP_TLS_INSECURE, see below.
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USERNAME=helpdesk@example.com
SMTP_PASSWORD=CHANGE_ME_smtp_token
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_FROM_NAME=Helpdesk
# Must be the address the SMTP token was issued for; Proton rejects anything else.
SMTP_FROM_EMAIL=helpdesk@example.com
# Where replies go. A plain address - the ticket reference travels in the
# subject line and the message body, never in the address.
SMTP_REPLY_TO_EMAIL=helpdesk@example.com
# Only for a local relay presenting a self-signed certificate (Proton Bridge).
# Prefer the CA certificate; the insecure flag is refused for non-local hosts.
SMTP_CA_CERT=
SMTP_TLS_INSECURE=false

# ---------- Inbound email (IMAP) ----------
# Proton has no public IMAP: receiving needs Proton Mail Bridge, which listens
# locally and upgrades with STARTTLS. See docs/email.md.
#   IMAP_HOST=protonmail-bridge   IMAP_PORT=1143   IMAP_SECURITY=starttls
#   IMAP_CA_CERT=/certs/bridge.pem   (or IMAP_TLS_INSECURE=true on a local host)
# Leave INBOUND_EMAIL_ENABLED=false to run send-only.
INBOUND_EMAIL_ENABLED=false
IMAP_HOST=protonmail-bridge
IMAP_PORT=1143
IMAP_USERNAME=helpdesk@example.com
IMAP_PASSWORD=CHANGE_ME_bridge_password
# ssl (993) | starttls (Bridge, 1143) | none (local only)
IMAP_SECURITY=starttls
IMAP_CA_CERT=
IMAP_TLS_INSECURE=false
IMAP_FOLDER=INBOX
# Fetched mail is moved here once turned into a ticket. Empty = mark read only.
IMAP_PROCESSED_FOLDER=Processed
IMAP_POLL_SECONDS=60

# ---------- Attachments ----------
ATTACHMENT_DIR=/data/attachments
MAX_ATTACHMENT_MB=25
MAX_EMAIL_MB=40

# ---------- Reverse proxy ----------
# The docker network your Nginx Proxy Manager container is on, so NPM can
# reach http://helpdesk-web:8080. Find it with: docker network ls
PROXY_NETWORK=npm_default
# Trust CF-Connecting-IP for client IPs. Only true when every route to the app
# passes through the Cloudflare tunnel - otherwise the header can be spoofed
# and the login rate limiter sidestepped.
TRUST_CLOUDFLARE_HEADERS=true
# Optional: verify Cloudflare Access JWTs in front of the login page.
CF_ACCESS_ENABLED=false
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=
